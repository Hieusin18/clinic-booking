# Caddy tự xin chứng chỉ HTTPS cho tên miền trong biến DOMAIN.
# Demo trên laptop qua mạng LAN: đặt DOMAIN=:80 (HTTP, không cần tên miền)
{$DOMAIN} {
	encode gzip

	# Số liệu cho Prometheus chỉ đọc trong mạng Docker (backend:3000), không mở ra ngoài
	handle /api/metrics* {
		respond 404
	}

	# API và Swagger
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Web app (React build ra web/dist)
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
