# Sao chép thành .env trên server. KHÔNG commit file .env lên Git.
# DOMAIN quyết định cách Caddy phục vụ:
#   :80                     → HTTP thường trên mọi IP của máy (demo qua Wi-Fi: http://<IP-laptop>)
#   localhost               → HTTPS tự ký, chỉ mở được trên chính máy đó
#   ten-mien-that.example   → HTTPS Let's Encrypt (khi có VPS và tên miền)
DOMAIN=:80
POSTGRES_USER=clinic
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=clinic
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
QR_SECRET=doi-thanh-chuoi-ngau-nhien-khac
QR_TTL_SECONDS=60
CLINIC_ID=phong-kham-1
