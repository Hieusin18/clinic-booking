# Sao chép thành .env trên server. KHÔNG commit file .env lên Git.
# DOMAIN quyết định cách Caddy phục vụ:
#   :80                     → HTTP thường trên mọi IP của máy (demo qua Wi-Fi: http://<IP-laptop>)
#   localhost               → HTTPS tự ký, chỉ mở được trên chính máy đó
#   ten-mien-that.example   → HTTPS Let's Encrypt (khi có VPS và tên miền)
DOMAIN=:80
POSTGRES_USER=clinic
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=clinic
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
QR_SECRET=doi-thanh-chuoi-ngau-nhien-khac
QR_TTL_SECONDS=60
CLINIC_ID=phong-kham-1
# In trên bệnh án và đơn thuốc (PDF/Word). CLINIC_CODE: mã cơ sở 5 ký tự, đứng đầu mã đơn thuốc
CLINIC_NAME=Phòng khám Đa khoa
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_CODE=PK001

# Hàng đợi (bỏ trống = dùng giá trị mặc định trong ngoặc)
# Check-in lịch hẹn được từ giờ hẹn − CHECKIN_EARLY_MINUTES (30) đến giờ hẹn + CHECKIN_LATE_MINUTES (15);
# quá mốc sau mà chưa check-in thì lịch hẹn thành "không đến"
CHECKIN_EARLY_MINUTES=
CHECKIN_LATE_MINUTES=
# Người đặt lịch được ưu tiên gọi từ giờ hẹn − QUEUE_PRIORITY_LEAD_MINUTES (10);
# sau QUEUE_WALK_IN_EVERY (3) lượt ưu tiên liên tiếp thì gọi 1 người vãng lai (0 = tắt)
QUEUE_PRIORITY_LEAD_MINUTES=
QUEUE_WALK_IN_EVERY=
# Thời gian khám trung bình (12 phút), chỉ dùng để ước tính giờ được gọi trên app
QUEUE_AVG_EXAM_MINUTES=
# Không đến NO_SHOW_LIMIT (3) lần trong NO_SHOW_WINDOW_DAYS (30) ngày thì khóa đặt lịch online NO_SHOW_LOCK_DAYS (14) ngày
NO_SHOW_LIMIT=
NO_SHOW_WINDOW_DAYS=
NO_SHOW_LOCK_DAYS=

# Xác minh số điện thoại khi đăng ký / quên mật khẩu: người dùng NHẮN "PKXM <mã>" từ chính SIM của họ tới số
# của phòng khám (phòng khám không tốn tiền SMS). Xem README "Xác minh số điện thoại bằng tin nhắn".
# REQUIRE_PHONE_VERIFICATION=false để tắt bước này khi đăng ký (mặc định bật)
REQUIRE_PHONE_VERIFICATION=
# Số SIM của máy cổng nhận tin (bệnh nhân nhắn tới số này)
SMS_VERIFY_NUMBER=
# iPhone Phím tắt: mã bí mật gửi trong header X-Gateway-Token (chuỗi ngẫu nhiên dài)
SMS_GATEWAY_TOKEN=
# Android SMS Gateway: Settings → Webhooks → Signing Key
SMS_GATEWAY_SIGNING_KEY=

# Mật khẩu đăng nhập Grafana (giám sát, http://localhost:3001, tài khoản admin)
GRAFANA_ADMIN_PASSWORD=doi-mat-khau-grafana
