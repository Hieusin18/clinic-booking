# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# "./mvnw spring-boot:run" tự đọc file này (biến môi trường thật được ưu tiên hơn).
# File đọc theo định dạng .properties: giá trị có dấu tiếng Việt (CLINIC_NAME…) nên đặt bằng biến môi trường.
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic
PORT=3000
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
QR_SECRET=doi-thanh-chuoi-ngau-nhien-khac
QR_TTL_SECONDS=60
CLINIC_ID=phong-kham-1
# Cổng nội bộ của máy chủ Socket.IO (chỉ nghe 127.0.0.1); web/app vẫn kết nối qua <API>/socket.io ở cổng PORT
SOCKET_PORT=3002
