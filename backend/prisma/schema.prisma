// Schema CSDL cho hệ thống đặt lịch khám
// Sửa schema xong: npx prisma migrate dev --name <mo-ta> && npx prisma generate

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Bệnh nhân đến từ đâu: đặt online hay đến trực tiếp
enum VisitSource {
  ONLINE
  WALK_IN
}

/// Cách vào hàng đợi: tự quét QR hoặc qua lễ tân
enum CheckinMethod {
  QR
  RECEPTION
}

enum VisitStatus {
  WAITING
  IN_PROGRESS
  /// Bác sĩ đã gửi đi làm cận lâm sàng, đang chờ kết quả (bác sĩ rảnh để gọi người khác)
  AWAITING_RESULTS
  DONE
  LEFT
}

/// Bệnh nhân nhận kết quả cận lâm sàng thế nào
enum ResultMode {
  /// Làm xong quay lại phòng khám; có kết quả thì được ưu tiên gọi vào đọc kết quả
  RETURN
  /// Về nhà; bác sĩ đọc kết quả, kết luận, kê đơn và gửi lên app
  ONLINE
}

/// Bác sĩ gọi lượt này theo quy tắc nào (xem src/queue/queue-order.ts)
enum CallRule {
  /// Người vãng lai chờ sau nhiều lượt ưu tiên người đặt lịch liên tiếp
  FAIRNESS
  /// Người đặt lịch đã đến giờ hẹn
  APPOINTMENT
  /// Theo thứ tự đến quầy
  ARRIVAL
  /// Bác sĩ chọn đích danh
  MANUAL
  /// Quay lại đọc kết quả cận lâm sàng (ưu tiên trước mọi người)
  RESULTS
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
}

/// Tài khoản đăng nhập của cả 4 vai trò
model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String?  @unique
  phone        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Tăng lên khi đổi / đặt lại mật khẩu hoặc "đăng xuất mọi thiết bị": mọi token cũ hết hiệu lực
  tokenVersion       Int       @default(0)
  /// Đang dùng mật khẩu tạm (admin tạo hoặc đặt lại): phải đổi trước khi dùng hệ thống
  mustChangePassword Boolean   @default(false)
  /// Số lần nhập sai liên tiếp; đủ 5 lần thì tạm khóa tới lockedUntil
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?

  patient       Patient?
  doctor        Doctor?
  notifications Notification[]
  pushTokens    PushToken[]
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  doctors     Doctor[]
}

/// Bác sĩ. Hồ sơ (giới thiệu, kinh nghiệm, thế mạnh, quá trình đào tạo và công tác, ảnh)
/// hiện cho bệnh nhân xem trước khi đặt lịch.
model Doctor {
  id          String  @id @default(uuid())
  userId      String  @unique
  specialtyId String
  title       String?
  bio         String?
  /// Phòng khám, ví dụ "Phòng 2"; loa gọi số đọc tên phòng này
  room        String?
  /// Năm bắt đầu hành nghề; số năm kinh nghiệm tính từ năm này nên luôn đúng theo thời gian
  practiceSince Int?
  /// Thế mạnh chuyên môn, mỗi dòng một mục (bệnh hoặc kỹ thuật)
  expertise   String?

  user          User           @relation(fields: [userId], references: [id])
  specialty     Specialty      @relation(fields: [specialtyId], references: [id])
  schedules     Schedule[]
  visits        Visit[]
  prescriptions Prescription[]
  history       DoctorHistory[]
  avatar        DoctorAvatar?
}

enum DoctorHistoryKind {
  /// Quá trình đào tạo: văn bằng, chứng chỉ
  EDUCATION
  /// Quá trình công tác: chức vụ, nơi làm việc
  WORK
}

/// Một mốc trong quá trình đào tạo hoặc công tác của bác sĩ
model DoctorHistory {
  id       String            @id @default(uuid())
  doctorId String
  kind     DoctorHistoryKind
  fromYear Int
  /// null = đến nay
  toYear   Int?
  /// Chức vụ, vị trí (công tác) hoặc văn bằng (đào tạo)
  title    String
  /// Nơi công tác hoặc cơ sở đào tạo
  place    String

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

/// Ảnh đại diện bác sĩ, tách bảng để danh sách bác sĩ không phải đọc dữ liệu ảnh
model DoctorAvatar {
  doctorId  String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

/// Khung giờ bác sĩ mở cho đặt lịch.
/// Chống đặt trùng: khi đặt, chạy updateMany({ where: { id, isBooked: false }, data: { isBooked: true } })
/// trong transaction; count = 0 nghĩa là khung giờ vừa bị người khác đặt.
model Schedule {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime @db.Date
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)

  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointments Appointment[]

  @@unique([doctorId, startTime])
  @@index([doctorId, date])
}

model Appointment {
  id         String            @id @default(uuid())
  patientId  String
  scheduleId String
  status     AppointmentStatus @default(PENDING)
  reason     String?
  createdAt  DateTime          @default(now())

  /// Đã gửi nhắc lịch trước một ngày / trước một giờ (tránh gửi trùng)
  remindedDayAt  DateTime?
  remindedHourAt DateTime?

  patient  Patient  @relation(fields: [patientId], references: [id])
  schedule Schedule @relation(fields: [scheduleId], references: [id])
  visit    Visit?
}

/// Hồ sơ hành chính. userId null = bệnh nhân đến trực tiếp, chưa có tài khoản app;
/// khi đăng ký app bằng cùng SĐT thì gắn userId vào hồ sơ này.
model Patient {
  id          String   @id @default(uuid())
  userId      String?  @unique
  fullName    String
  dateOfBirth DateTime @db.Date
  gender      Gender
  phone       String   @unique
  nationalId  String?  @unique
  address     String?
  insuranceNo String?
  /// Hạn dùng thẻ BHYT
  insuranceExpiry DateTime? @db.Date
  allergies   String?
  occupation  String?
  ethnicity   String?
  /// Người nhà cần báo tin (với trẻ em: người đưa trẻ đến khám)
  relativeName  String?
  relativePhone String?
  createdAt   DateTime @default(now())

  /// Mã liên kết in trên phiếu khám / bệnh án: bệnh nhân nhập trên app để xem lịch sử khám cũ
  linkCode            String?   @unique
  /// Tài khoản app vừa gắn vào hồ sơ có sẵn mà chưa xác minh: lượt khám tạo trước mốc này bị ẩn,
  /// thông tin cá nhân lễ tân đã nhập bị che. Xác minh (mã liên kết hoặc lễ tân xem CCCD) thì xóa mốc.
  historyLockedBefore DateTime?
  verifiedAt          DateTime?
  /// Nhập sai mã liên kết liên tiếp; đủ 5 lần thì khóa nhập mã tới verifyLockedUntil
  verifyFailures      Int       @default(0)
  verifyLockedUntil   DateTime?

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
  visits       Visit[]
}

/// Phiếu khám = một vị trí trong hàng đợi của bác sĩ.
/// Hai dãy số: A (đặt lịch, ONLINE) và B (vãng lai, WALK_IN), mỗi dãy đánh số từ 1 mỗi ngày.
/// Cấp số trong transaction; unique (doctorId, date, source, queueNumber) chặn trùng số.
model Visit {
  id            String        @id @default(uuid())
  patientId     String
  doctorId      String
  date          DateTime      @db.Date
  queueNumber   Int
  source        VisitSource
  checkinMethod CheckinMethod
  status        VisitStatus   @default(WAITING)
  reason        String?
  appointmentId String?       @unique
  /// Giờ hẹn của lượt đặt online; người đặt lịch được ưu tiên gọi từ giờ hẹn trừ vài phút
  appointmentAt DateTime?
  /// Lễ tân check-in ngoài khung giờ cho phép (đến quá sớm hoặc quá trễ)
  checkinOverride Boolean     @default(false)
  calledAt      DateTime?
  callRule      CallRule?
  /// Cách nhận kết quả cận lâm sàng; null = chưa gửi đi làm cận lâm sàng
  resultMode     ResultMode?
  /// Lúc bác sĩ gửi đi làm cận lâm sàng
  sentForTestsAt DateTime?
  /// Lúc có kết quả và bệnh nhân vào lại hàng chờ (chế độ quay lại)
  resultsReadyAt DateTime?
  /// Lúc bác sĩ hoàn tất lượt khám (thống kê thời gian khám)
  completedAt    DateTime?
  createdAt     DateTime      @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  medicalRecord MedicalRecord?
  prescriptions Prescription[]
  labOrders     LabOrder[]

  @@unique([doctorId, date, source, queueNumber])
  @@index([patientId, date])
}

/// Bệnh án ngoại trú của một lượt khám, theo bố cục mẫu bệnh án Bộ Y tế. Chỉ bác sĩ phụ trách được ghi.
model MedicalRecord {
  id        String   @id @default(uuid())
  visitId   String   @unique

  // III. Hỏi bệnh
  /// Lý do đến khám
  reason          String?
  /// Quá trình bệnh lý (bệnh sử, triệu chứng)
  symptoms        String
  personalHistory String?
  familyHistory   String?

  // IV. Khám bệnh: dấu hiệu sinh tồn
  /// lần/phút
  pulse           Int?
  /// °C
  temperature     Float?
  /// mmHg
  bpSystolic      Int?
  bpDiastolic     Int?
  /// lần/phút
  respiratoryRate Int?
  /// %
  spo2            Int?
  /// kg
  weight          Float?
  /// cm
  height          Float?
  generalExam     String?
  organExam       String?
  /// Tóm tắt kết quả cận lâm sàng
  labSummary      String?
  /// Chỉ định cận lâm sàng
  orders          String?

  // V. Chẩn đoán (mã ICD-10)
  diagnosis          String
  icdCode            String?
  secondaryDiagnosis String?
  /// Mã ICD-10 bệnh kèm theo, cách nhau bởi dấu phẩy
  secondaryIcdCodes  String?

  // VI. Điều trị
  treatment    String?
  followUpDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id])
}

/// Một chỉ định cận lâm sàng (X-quang, siêu âm, xét nghiệm…). Bác sĩ phụ trách ghi kết quả và tải tệp lên.
model LabOrder {
  id         String    @id @default(uuid())
  visitId    String
  /// Tên chỉ định, ví dụ "X-quang ngực thẳng"
  name       String
  /// Ghi chú kèm chỉ định (vị trí, yêu cầu)
  note       String?
  /// Mô tả và kết luận kết quả
  resultText String?
  /// Lúc bác sĩ trả kết quả; null = chưa có kết quả
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  visit Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  files LabFile[]

  @@index([visitId])
}

/// Tệp kết quả (ảnh chụp phim, phiếu kết quả PDF). Tách bảng để danh sách không phải đọc dữ liệu tệp.
model LabFile {
  id         String   @id @default(uuid())
  labOrderId String
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([labOrderId])
}

/// Danh mục thuốc do admin quản lý
model Medicine {
  id               String  @id @default(uuid())
  name             String
  activeIngredient String?
  strength         String?
  unit             String
  isActive         Boolean @default(true)

  items PrescriptionItem[]
}

/// Đơn thuốc. Khóa khi FINALIZED; cần sửa thì tạo đơn mới với replacesId trỏ về đơn cũ.
model Prescription {
  id          String             @id @default(uuid())
  /// Mã đơn thuốc dạng xxxxxyyyyyyy-z (Thông tư 26/2025/TT-BYT), cấp khi hoàn tất đơn
  code        String?            @unique
  visitId     String
  doctorId    String
  advice      String?
  status      PrescriptionStatus @default(DRAFT)
  finalizedAt DateTime?
  replacesId  String?            @unique
  createdAt   DateTime           @default(now())

  visit      Visit              @relation(fields: [visitId], references: [id])
  doctor     Doctor             @relation(fields: [doctorId], references: [id])
  replaces   Prescription?      @relation("PrescriptionReplacement", fields: [replacesId], references: [id])
  replacedBy Prescription?      @relation("PrescriptionReplacement")
  items      PrescriptionItem[]
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  medicineId     String
  quantity       Int
  dosePerTime    String
  timesPerDay    Int
  days           Int
  note           String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])
}

enum NotificationType {
  /// Bác sĩ gọi số (hoặc gọi lại)
  CALLED
  /// Có kết quả cận lâm sàng, mời quay lại phòng khám (chế độ quay lại)
  RESULTS_READY
  /// Khám xong: có kết luận, đơn thuốc và kết quả (chế độ nhận kết quả online)
  VISIT_DONE
  /// Nhắc lịch hẹn sắp tới
  APPOINTMENT_REMINDER
}

/// Hộp thư thông báo của bệnh nhân; đồng thời được đẩy về điện thoại nếu đã đăng ký token
model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  body          String
  /// Màn hình trong app mở khi bấm, ví dụ "/visit/<id>"
  url           String?
  visitId       String?
  appointmentId String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Expo push token của từng máy đã đăng nhập (một tài khoản có thể dùng nhiều máy)
model PushToken {
  token     String   @id
  userId    String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PhoneVerifyPurpose {
  /// Đăng ký tài khoản app
  REGISTER
  /// Quên mật khẩu
  RESET_PASSWORD
}

/// Xác minh số điện thoại kiểu "nhắn tin để xác thực": người dùng nhắn mã từ chính SIM của họ tới số của phòng khám
model PhoneVerification {
  id         String             @id @default(uuid())
  phone      String
  purpose    PhoneVerifyPurpose
  /// 6 chữ số, người dùng nhắn "PKXM <mã>"
  code       String
  /// SHA-256 của vé bí mật trả cho app (chỉ app tạo phiên mới hỏi trạng thái / dùng được phiên)
  ticketHash String
  ip         String?
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([phone, createdAt])
  @@index([code])
}

/// Tin nhắn cổng SMS chuyển tới (iPhone Phím tắt, Android SMS Gateway, hoặc giả lập), để admin theo dõi
model InboundSms {
  id             String   @id @default(uuid())
  source         String
  fromRaw        String
  /// Số đã chuẩn hóa 0xxxxxxxxx (null nếu người gửi không phải số điện thoại, vd. email iMessage)
  phone          String?
  body           String
  /// VERIFIED / WRONG_SENDER / NO_MATCH / INVALID_SENDER
  result         String
  verificationId String?
  receivedAt     DateTime @default(now())

  @@index([receivedAt])
}
